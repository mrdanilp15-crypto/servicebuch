# Server
PORT=4000
NODE_ENV=development
# Zeitzone für den täglichen Erinnerungs-Cronjob (08:00) und PDF-Zeitstempel.
TZ=Europe/Berlin
# Nur setzen, wenn das Frontend von einer ANDEREN Adresse direkt auf die API
# zugreift (aktiviert CORS). Mit dem mitgelieferten Same-Origin-Proxy nicht nötig.
# FRONTEND_URL=http://localhost:3000

# Database (SQLite by default - zero setup. For Postgres/MySQL, change the
# provider in prisma/schema.prisma and set the corresponding connection string)
DATABASE_URL="file:./dev.db"

# --- Alles ab hier ist OPTIONAL -------------------------------------------
# JWT_SECRET, UPLOAD_ENCRYPTION_KEY und die VAPID-Keys werden automatisch
# generiert und in data/.secrets.json gespeichert, wenn sie hier leer
# gelassen werden (siehe backend/src/utils/secrets.js). Nur setzen, wenn du
# feste, selbst kontrollierte Werte brauchst (z.B. um dieselben Secrets über
# mehrere Instanzen hinweg zu teilen).

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
# 32-byte hex key (64 Hex-Zeichen) zur Verschlüsselung von Uploads (AES-256-GCM)
UPLOAD_ENCRYPTION_KEY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Reminder thresholds
TUEV_WARNING_DAYS=30
SERVICE_INTERVAL_KM_WARNING=1000

# Registrierung: Der erste Nutzer legt sich selbst an (wird Admin). Danach ist
# die Selbstregistrierung geschlossen und der Admin legt Konten an. 'true'
# erlaubt dauerhaft offene Registrierung (nicht empfohlen bei Internet-Zugang).
REGISTRATION_OPEN=false

# Erinnerungen: nach der ersten Meldung nur alle X Tage erneut erinnern.
REMINDER_REPEAT_DAYS=7

# Anbieterangaben für Impressum und Datenschutzerklärung (siehe README
# "Rechtliches"). Bei rein privater Nutzung leer lassen. Zeilenumbrüche in
# der Adresse als 
 schreiben.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=
LEGAL_OPERATOR_PHONE=
